# These values are safe to expose in a browser when Row Level Security is enabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional. The default is the same-origin Vite middleware that uploads to R2.
VITE_IMAGE_UPLOAD_URL=/api/blog-images

# Public R2 URL for serving uploaded objects (custom domain or r2.dev).
# Set this to your actual domain before deploying.
PUBLIC_R2_URL=https://your-bucket.your-account.r2.dev

# Cloudflare R2 credentials — server-side only. Keep these out of VITE_ vars.
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
