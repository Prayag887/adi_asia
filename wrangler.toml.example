name = "adi-asia"
compatibility_date = "2026-07-22"
pages_build_output_dir = "dist"

[[r2_buckets]]
binding = "BLOG_IMAGES"
bucket_name = "adi-asia-blog-images"

# Set these as Cloudflare Pages environment variables, not in this file:
# PUBLIC_R2_URL=https://images.your-domain.com
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
