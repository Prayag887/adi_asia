ADMIN_HOST=admin.folio.example
BASE_DOMAIN=folio.example
# Public IPv4/IPv6 of the VPS — domain verification checks DNS points here.
SERVER_IPS=203.0.113.10
SECURE_COOKIES=true
HEALTH_INTERVAL_SECS=300

# Cloudflare R2 for uploaded images (omit all five to store on local disk instead).
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=adi-asia-blog-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://images.folio.example

RUST_LOG=folio=info,tower_http=warn
