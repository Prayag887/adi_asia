{
	admin off
	auto_https off
}

# Cloudflare terminates HTTPS; the tunnel forwards plain HTTP here.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy folio-api:3000
	}
	handle /admin* {
		reverse_proxy folio-api:3000
	}

	@site file {
		root /srv/sites/hosts/{host}
		try_files {path} {path}/index.html /index.html
	}
	handle @site {
		root * /srv/sites/hosts/{host}
		try_files {path} {path}/index.html /index.html
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy folio-api:3000
	}
}
