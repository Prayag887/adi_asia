---
import Logo from "@components/ui/atoms/Logo.astro";
import MenuToggle from "@components/ui/molecules/Navbar/shared/MenuToggle.astro";
import type { NavTheme } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { formatInternalLink } from "@utils/url";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

export interface Props {
	theme?: NavTheme;
	locale?: NovaLocale;
}

const { theme = "light", locale = "pl" } = Astro.props;
const headerData = getNovaCopy(locale).navigation;

// A single fixed header keeps every navigation link available while scrolling.
const isDark = theme === "dark" || theme === "transparent";

const fixedShellClass = isDark
	? "border-white/10 bg-brand-dark/95 text-white shadow-lg shadow-black/20"
	: "border-brand-dark/10 bg-[var(--ui-bg-page)]/95 text-brand-dark shadow-lg shadow-black/5";
---

<header
	data-site-header
	transition:animate="none"
	class:list={["fixed left-0 top-0 z-[1000] w-full border-b", fixedShellClass]}
>
	<div class="ui-container">
		<div class="flex items-center justify-between gap-2 py-3 sm:gap-4 sm:py-4 lg:gap-6 lg:py-5" data-nav-inner>
			<a href={getNovaNavigationPath("/", locale)} class="nova-site-logo relative z-[1010] flex min-w-0 shrink-0 items-center">
				<Logo variant={isDark ? "light" : "dark"} density="compact" />
			</a>

			<nav class="hidden min-w-0 flex-1 items-center justify-center gap-5 lg:flex xl:gap-8">
				{headerData.menu.map((item) => (
					<a href={getNovaNavigationPath(item.href, locale)} class="ui-nav-bar-link shrink-0 opacity-75 transition-opacity hover:opacity-100">
						{item.label}
					</a>
				))}
			</nav>

			<div class="relative z-[1010] flex shrink-0 items-center gap-2 sm:gap-3">
				<!-- Dlaczego: globalny wzorzec przycisku (ui-button ui-button-primary ui-nav-cta)
         instead of raw classes. Gives consistent hover (text swap + color slide) and dimensions
				     z core.css. Wzorzec z NavbarMainCentered (layout Centered). -->
				<a href={formatInternalLink(headerData.cta.href)} class="ui-button ui-button-primary ui-nav-cta hidden sm:flex">
					<span class="ui-button-text-wrap">
						<span class="ui-button-text-default">{headerData.cta.label}</span>
						<span class="ui-button-text-hover">{headerData.cta.hoverLabel}</span>
					</span>
				</a>
				<MenuToggle locale={locale} />
			</div>
		</div>
	</div>
</header>

<style>

	:global(html[data-theme="nova"] header[data-site-header]) {
		left: 0;
		width: 100%;
		transform: none;
		border-color: transparent;
		background: var(--color-surface);
		color: var(--color-on-surface);
		box-shadow: none;
	}

	:global(html[data-theme="nova"] header[data-site-header]) {
		border-radius: 0;
	}


	:global(html[data-theme="nova"] header[data-site-header] [data-nav-inner]) {
		padding-top: 0.8rem;
		padding-bottom: 0.8rem;
	}

	:global(html[data-theme="nova"] header[data-site-header] .ui-container) {
		max-width: none;
		padding-inline: clamp(1.5rem, 5vw, 5rem);
	}

	:global(html[data-theme="nova"] header[data-site-header]) {
		left: 0;
		width: 100%;
		transform: none;
	}

	:global(html[data-theme="nova"] header[data-site-header] nav) {
		gap: clamp(1rem, 2vw, 2.25rem);
	}

	:global(html[data-theme="nova"] header[data-site-header] .ui-nav-bar-link) {
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		opacity: 0.72;
	}

	@media (min-width: 1280px) {
		:global(html[data-theme="nova"] header[data-site-header] .ui-nav-bar-link) {
			font-size: 1.0625rem;
		}
	}

	:global(html[data-theme="nova"] header[data-site-header] .ui-nav-cta) {
		border-radius: 9999px;
		padding: 0.7rem 1.2rem;
		background: var(--color-brand-dark);
		color: var(--color-brand-light);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		letter-spacing: 0.02em;
	}
</style>
