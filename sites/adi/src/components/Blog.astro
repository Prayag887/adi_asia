---
import Icon from '@/components/Icon.astro';
---
<section id="blog" class="scroll-mt-20 bg-[#faf9f6] py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="mb-14 flex items-end justify-between gap-4 border-b border-[#b8946a]/25 pb-8"><div><p class="section-label">Perspectives</p><h1 class="mt-3 font-cormorant text-5xl font-semibold text-[#0f1e33] sm:text-6xl">ADI Journal</h1></div><button type="button" data-blog-write style="display: none;" class="inline-flex items-center gap-2 rounded bg-[#0f1e33] px-4 py-2 font-inter text-sm text-[#f8f6f1] hover:bg-[#1a2942]"><Icon name="Plus" class="h-4 w-4" />Write a post</button></div>
    <div data-blog-body data-editor-ignore><Icon name="LoaderCircle" class="h-6 w-6 animate-spin text-[#b8946a]" /></div>
  </div>
</section>

<template data-tpl="blog-grid"><div class="grid gap-x-7 gap-y-12 md:grid-cols-2 lg:grid-cols-3"></div></template>

<template data-tpl="blog-card"><article class="group relative">
  <button type="button" data-open class="block w-full text-left">
    <span data-image></span>
    <p data-date class="mt-5 font-inter text-[11px] uppercase tracking-[.18em] text-[#9a7b52]"></p>
    <h2 data-title class="mt-2 font-cormorant text-3xl font-semibold leading-tight text-[#0f1e33] transition-colors group-hover:text-[#9a7b52]"></h2>
    <p data-excerpt class="mt-3 line-clamp-3 font-inter text-sm leading-6 text-[#64748b]"></p>
    <span class="mt-4 inline-flex items-center gap-2 font-inter text-xs font-medium uppercase tracking-[.12em] text-[#0f1e33]">Read story <Icon name="ArrowRight" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" /></span>
  </button>
  <div data-admin class="absolute top-2 right-2 flex gap-1 opacity-0 transition-opacity group-hover:opacity-100">
    <button type="button" data-edit class="rounded bg-[#0f1e33]/90 p-1.5 text-[#f8f6f1] hover:bg-[#0f1e33]" title="Edit post"><Icon name="Pencil" class="h-3.5 w-3.5" /></button>
    <button type="button" data-delete class="rounded bg-red-600/90 p-1.5 text-white hover:bg-red-600" title="Delete post"><Icon name="Trash2" class="h-3.5 w-3.5" /></button>
  </div>
</article></template>

<template data-tpl="post-cover"><img alt="" /></template>
<template data-tpl="post-placeholder"><div role="img" aria-label="ADI Journal cover">
  <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full border border-[#b8946a]/30"></div>
  <div class="absolute -bottom-20 -left-10 h-52 w-52 rounded-full border border-[#b8946a]/20"></div>
  <div class="absolute inset-0 flex items-center justify-center font-cinzel text-xs uppercase tracking-[.35em] text-[#d9bd94]">ADI Journal</div>
</div></template>

<template data-tpl="blog-more"><div class="mt-14 text-center"><button type="button" class="rounded border border-[#0f1e33] px-7 py-3 font-inter text-sm font-medium text-[#0f1e33] transition-colors hover:bg-[#0f1e33] hover:text-white">Show more</button></div></template>

<template data-tpl="blog-empty"><div class="py-16 text-center"><Icon name="PenLine" class="mx-auto mb-4 h-8 w-8 text-[#b8946a]" /><p class="font-cormorant text-3xl text-[#0f1e33]">Stories and insights are on their way.</p><button type="button" data-first style="display: none;" class="mt-5 font-inter text-sm text-[#9a7b52] underline">Write the first post</button></div></template>

<template data-tpl="blog-loader"><Icon name="LoaderCircle" class="h-6 w-6 animate-spin text-[#b8946a]" /></template>

<template data-tpl="blog-form"><form class="rounded border border-[#b8946a]/30 bg-white p-6 shadow-sm">
  <input required name="title" placeholder="A title for your post" class="mb-5 w-full border-b border-[#b8946a]/40 px-0 py-3 font-cormorant text-4xl text-[#0f1e33] outline-none" />
  <label class="mb-5 block cursor-pointer overflow-hidden rounded border border-dashed border-[#b8946a]/50 font-inter text-sm text-[#4a5568] hover:bg-[#faf9f6]">
    <span data-with-preview class="contents" style="display: none;"><img data-preview alt="Cover preview" class="aspect-[16/7] w-full object-cover" /><span class="flex items-center gap-2 px-4 py-3"><Icon name="ImagePlus" class="h-4 w-4 text-[#9a7b52]" /><span data-cover-name></span><span data-cover-action class="ml-auto text-[#9a7b52]"></span></span></span>
    <span data-without-preview class="flex items-center gap-2 px-4 py-6"><Icon name="ImagePlus" class="h-4 w-4 text-[#9a7b52]" />Select a cover image from your device <span class="text-[#64748b]">(optional)</span></span>
    <input name="cover" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" />
  </label>
  <textarea required name="body" placeholder="Start writing…" class="min-h-80 w-full resize-y font-inter leading-relaxed text-[#334155] outline-none"></textarea>
  <p data-error class="mt-4 font-inter text-sm text-red-700" style="display: none;"></p>
  <div class="mt-5 flex justify-end gap-3">
    <button type="button" data-cancel class="px-4 py-2 text-sm text-[#4a5568]">Cancel</button>
    <button data-submit class="rounded bg-[#b8946a] px-5 py-2 text-sm text-[#0f1e33] disabled:opacity-60"><span data-spinner style="display: none;"><Icon name="LoaderCircle" class="mr-1 inline h-4 w-4 animate-spin" /></span><span data-submit-label></span></button>
  </div>
</form></template>
