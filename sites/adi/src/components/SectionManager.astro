---
import Icon from '@/components/Icon.astro';

const sectionList = [
  ['hero', 'Hero'], ['about', 'About'], ['ourWork', 'Our Work'], ['sectoralFocus', 'Focus Areas'], ['asgpp', 'ASGPP'], ['impact', 'Impact'], ['contact', 'Contact'],
];
---
<button type="button" data-sections-open data-editor-ignore style="display: none;" class="fixed bottom-20 right-5 z-[61] inline-flex items-center gap-2 rounded-full bg-[#f8f6f1] px-4 py-3 font-inter text-sm text-[#0f1e33] shadow-xl ring-1 ring-[#b8946a]/40 hover:bg-white"><Icon name="LayoutPanelTop" class="h-4 w-4 text-[#9a7b52]" />Manage sections</button>

<div data-sections-panel data-editor-ignore class="fixed inset-0 z-[70] bg-[#0a1525]/65 p-4 backdrop-blur-sm" style="display: none;"><div class="ml-auto h-full w-full max-w-lg overflow-y-auto rounded-xl bg-[#faf9f6] p-6 shadow-2xl"><div class="mb-7 flex items-start justify-between"><div><p class="section-label">Page structure</p><h2 class="mt-2 font-cormorant text-3xl text-[#0f1e33]">Manage sections</h2><p class="mt-2 font-inter text-sm text-[#4a5568]">Hide or restore existing sections, or add new ones.</p></div><button type="button" data-sections-close class="rounded p-2 text-[#4a5568] hover:bg-[#e8e4dc]"><Icon name="X" /></button></div><div class="space-y-2">{sectionList.map(([key, label]) => <button type="button" data-section-toggle={key} class="flex w-full items-center justify-between rounded-lg border border-[#0f1e33]/10 bg-white px-4 py-3 text-left font-inter text-sm text-[#0f1e33] hover:border-[#b8946a]/60"><span>{label}</span><span data-state="hidden" style="display: none;" class="inline-flex items-center gap-1 text-[#9a7b52]"><Icon name="EyeOff" class="h-4 w-4" />Hidden</span><span data-state="visible" class="inline-flex items-center gap-1 text-[#55735b]"><Icon name="Eye" class="h-4 w-4" />Visible</span></button>)}</div><div class="my-8 border-t border-[#0f1e33]/10"></div><h3 class="font-cormorant text-2xl text-[#0f1e33]">Add a new section</h3><form data-custom-form class="mt-4 space-y-3"><input required name="title" placeholder="Section title" class="w-full rounded border border-[#0f1e33]/20 bg-white px-3 py-2 font-inter text-sm outline-none focus:border-[#b8946a]" /><textarea required name="body" placeholder="Write the section content…" class="min-h-28 w-full rounded border border-[#0f1e33]/20 bg-white px-3 py-2 font-inter text-sm outline-none focus:border-[#b8946a]"></textarea><button class="inline-flex items-center gap-2 rounded bg-[#0f1e33] px-4 py-2 font-inter text-sm text-[#f8f6f1]"><Icon name="Plus" class="h-4 w-4" />Add section</button></form><div data-custom-list class="mt-7 space-y-2" style="display: none;"></div></div></div>

<template data-tpl="custom-row"><div class="flex items-center justify-between rounded border border-[#0f1e33]/10 bg-white px-3 py-2"><span data-title class="font-inter text-sm text-[#0f1e33]"></span><button type="button" data-delete class="rounded p-1.5 text-red-700 hover:bg-red-50" title="Delete section"><Icon name="Trash2" class="h-4 w-4" /></button></div></template>
