---
import Icon from '@/components/Icon.astro';
import { fontChoices } from '@/lib/typography';
---
<button type="button" data-type-open data-editor-ignore style="display: none;" class="fixed bottom-36 right-5 z-[61] inline-flex items-center gap-2 rounded-full bg-[#f8f6f1] px-4 py-3 font-inter text-sm text-[#0f1e33] shadow-xl ring-1 ring-[#b8946a]/40 hover:bg-white"><Icon name="Type" class="h-4 w-4 text-[#9a7b52]" />Typography</button>

<div data-type-panel data-editor-ignore class="fixed inset-0 z-[72] grid place-items-center bg-[#0a1525]/65 p-4 backdrop-blur-sm" style="display: none;"><div class="w-full max-w-lg rounded-xl bg-[#faf9f6] p-6 shadow-2xl"><div class="flex items-start justify-between"><div><p class="section-label">Site-wide style</p><h2 class="mt-2 font-cormorant text-3xl text-[#0f1e33]">Choose a font</h2><p class="mt-2 font-inter text-sm text-[#4a5568]">This applies to the entire experience, including navigation, buttons, headings, body copy, and the blog.</p></div><button type="button" data-type-close class="rounded p-2 text-[#4a5568] hover:bg-[#e8e4dc]"><Icon name="X" /></button></div><div class="mt-6 grid gap-3 sm:grid-cols-2">{Object.entries(fontChoices).map(([key, font]) => <button type="button" data-font={key} class="rounded-lg border p-4 text-left transition border-[#0f1e33]/10 bg-white hover:border-[#b8946a]/50"><span class="block text-xl text-[#0f1e33]" style={`font-family: ${font.value};`}>{font.label}</span><span class="mt-1 block font-inter text-xs text-[#4a5568]">The quick brown fox</span></button>)}</div><div class="mt-7 flex justify-end gap-3"><button type="button" data-type-close class="px-4 py-2 font-inter text-sm text-[#4a5568]">Cancel</button><button type="button" data-type-save class="rounded bg-[#0f1e33] px-5 py-2 font-inter text-sm text-[#f8f6f1]"><span data-type-spin style="display: none;"><Icon name="LoaderCircle" class="mr-1 inline h-4 w-4 animate-spin" /></span><span data-type-check><Icon name="Check" class="mr-1 inline h-4 w-4" /></span>Save typography</button></div></div></div>
