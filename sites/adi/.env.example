# Public URL of the Cloudflare R2 bucket (custom domain or r2.dev). Used for the logo
# and other static assets baked into the build.
PUBLIC_R2_URL=https://images.your-domain.com

# Local development only: where `npm start` proxies /api, and which tenant host to act as.
FOLIO_API_URL=http://127.0.0.1:3000
FOLIO_DEV_HOST=adi.localhost
